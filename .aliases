# --- claude ---
alias ca="claude"
alias cac="claude -c" # --continue
alias car="claude -r" # --resume
alias chs="yadm-private add ~/.claude/settings.json ~/.claude/projects ~/.claude/history.jsonl"
alias chc="yadm-private commit -m 'chore(claude): sync settings, session history, and project transcripts'"
alias chap="chs && chc && yadm-private push"

# --- codex ---
alias co="codex"
alias cor="codex resume"
alias cos="yadm-private add ~/.codex/config.toml ~/.codex/AGENTS.md ~/.codex/sessions ~/.codex/history.jsonl ~/.codex/session_index.jsonl"
alias coc="yadm-private commit -m 'chore(codex): sync config, session history, and transcripts'"
alias coap="cos && coc && yadm-private push"

# --- dropbox ---
alias cdd="cd ~/Library/CloudStorage/Dropbox/"
alias cdb="cd ~/Library/CloudStorage/Dropbox/bk/"

# --- firefox history ---
alias fhd="~/scripts/firefox-history-dump.zsh"

# --- git ---
# git develop and main, or git deploy
alias ga="git add"
alias gdp="git checkout main && git merge dev && git push && git checkout dev"
alias gs="git status"
alias gcm="git commit -m"
alias gam="git add . && git commit -m"
alias gps="git push"
alias gf="git fetch"
alias gpl="git pull"
alias gd="git diff"
alias gds="git diff | delta --side-by-side"
alias gsh="git show"
alias gshs="git show | delta --side-by-side"
alias gdw="git diff --word-diff"
alias gdc="git diff --color-words"
alias gl="git log"
alias glo="git log --oneline"
alias gre="git restore"
alias gba="git branch -a"

# --- go ---
# run these inside a Go module
alias goo="go list -m -u all"
alias gou="go get -u ./... && go mod tidy"
alias gol="go list -m all > ~/go-packages.txt"

# --- homebrew ---
# "brew update"
alias bu="brew update --verbose && brew upgrade --verbose && brew cleanup --verbose --prune=all"
alias bd="brew doctor"
# "brew log"
alias bl="brew leaves > ~/brew-leaves.txt && brew list > ~/brew-list.txt && brew list --cask > ~/brew-list-cask.txt"
# "brew display logs"
alias bdl="less ~/brew-leaves.txt && less ~/brew-list.txt && less ~/brew-list-cask.txt"

# --- java ---
alias jr="javac -Xlint:unchecked Main.java && java Main"

# --- neovim ---
alias n="nvim"
alias nu="nvim --headless '+Lazy! sync' +qa && yadm-public add ~/.config/nvim/lazy-lock.json && (yadm-public diff --cached --quiet || (yadm-public commit -m 'chore(nvim): bump deps' && yadm-public push))"
alias nuq="{ nu; } >/dev/null 2>&1 && echo 'nu: ok' || echo 'nu: failed (run nu to see why)'"
# "bob log": installed Neovim versions, color codes stripped
bobl() {
  local out
  out=$(bob list) || return 1
  print -r -- "$out" | sed $'s/\e\\[[0-9;]*m//g' > ~/bob-versions.txt
}
# "bob display logs"
alias bobdl="less ~/bob-versions.txt"

# --- nvm node ---
# nvm update current
alias nvc="nvm install --lts --reinstall-packages-from=current && nvm alias default 'lts/*' && nvm use default && node -v && nvm version default"
# nvm update lts
alias nvl="nvm install --lts --reinstall-packages-from=node && nvm alias default 'lts/*' && nvm use default && node -v && nvm version default"

# --- npm ---
alias ngo="npm -g outdated"
alias ngu="npm -g update"
# "npm -g log"
alias ngl="npm -g list > ~/global-npm-packages.txt"
# "npm -g display logs"
alias ngdl="less ~/global-npm-packages.txt"
alias nrd="npm run dev"
alias nrb="npm run build"
alias nt="npm test"

# --- pipx ---
alias pxu="pipx upgrade-all"
# "pipx log"
alias pxl="pipx list > ~/pipx-packages.txt"
# "pipx display logs"
alias pxdl="less ~/pipx-packages.txt"

# --- postgres ---
alias pgstart='pg_ctl -D ~/postgres-data -l ~/postgres-data/server.log start'
alias pgstop='pg_ctl -D ~/postgres-data stop'
alias pgstatus='pg_ctl -D ~/postgres-data status'

# --- rustup ---
alias ru="rustup update"
# "rustc log"
alias rl="rustup toolchain list > ~/rust-toolchains.txt && cargo install --list > ~/cargo-packages.txt"
# "rustc display logs"
alias rdl="less ~/rust-toolchains.txt && less ~/cargo-packages.txt"

# --- tmuxinator ---
alias tx="tmuxinator"
alias txs="tmuxinator start"
alias txss="tmuxinator start session"

# --- yadm prompt ---
alias ypt="yadm-prompt-toggle both"
alias yptu="yadm-prompt-toggle public"
alias yptr="yadm-prompt-toggle private"

# --- yadm public ---
alias y="yadm-public"
alias ya="yadm-public add"
alias ys="yadm-public status"
alias ycm="yadm-public commit -m"
alias yd="yadm-public diff"
alias yds="yadm-public diff | delta --side-by-side"
alias ysh="yadm-public show"
alias yshs="yadm-public show | delta --side-by-side"
alias ydw="yadm-public diff --word-diff"
alias ydc="yadm-public diff --color-words"
alias yps="yadm-public push"
alias yan="yadm-public add ~/.config/nvim/"
alias yavs="yadm-public add ~/Library/Application\ Support/Code/User/settings.json"
alias yavk="yadm-public add ~/Library/Application\ Support/Code/User/keybindings.json"
alias yl="yadm-public log"
alias ylo="yadm-public log --oneline"

# --- yadm private ---
alias yr="yadm-private"
alias yra="yadm-private add"
alias yrs="yadm-private status"
alias yrcm="yadm-private commit -m"
alias yrd="yadm-private diff"
alias yrds="yadm-private diff | delta --side-by-side"
alias yrsh="yadm-private show"
alias yrshs="yadm-private show | delta --side-by-side"
alias yrdw="yadm-private diff --word-diff"
alias yrdc="yadm-private diff --color-words"
alias yrps="yadm-private push"
alias yrl="yadm-private log"
alias yrlo="yadm-private log --oneline"

# --- zsh ---
alias l="ls -laF"
alias rz='tmux list-panes -a -F '\''#{pane_id} #{pane_current_command}'\'' | awk '\''$2=="zsh"{print $1}'\'' | xargs -I{} tmux send-keys -t {} '\''exec zsh'\'' C-m'
alias rsh='tmux list-panes -a -F '\''#{pane_id} #{pane_current_command}'\'' | awk '\''$2=="zsh"{print $1}'\'' | xargs -I{} tmux send-keys -t {} '\''exec $SHELL'\'' C-m'

# --- weekly combos ---
# npm -g update, but fail when npm 12+ skips install scripts (exits 0 anyway) or the global tree is broken
nup() {
  local log rc
  log=$(mktemp) || return 1
  npm -g update 2>&1 | tee "$log"
  rc=${pipestatus[1]}
  if grep -q 'install-scripts' "$log"; then
    echo 'nup: npm skipped install scripts. Review the packages above, then:'
    echo '  npm config set allow-scripts=<current list>,<pkg> --location=user && npm -g rebuild <pkg>'
    rc=1
  fi
  rm -f "$log"
  npm -g ls --depth=0 >/dev/null || { echo 'nup: global npm tree is broken (npm -g ls)'; rc=1; }
  return $rc
}
# weekly update
wup() {
  local failed=0
  nvim --headless '+Lazy! sync' +qa || { echo 'Lazy sync failed'; failed=1; }
  pipx upgrade-all                  || { echo 'pipx failed'; failed=1; }
  nup                               || { echo 'npm failed'; failed=1; }
  rustup update                     || { echo 'rustup failed'; failed=1; }
  cargo binstall -y bob-nvim        || { echo 'bob self-update failed'; failed=1; }
  bob update                        || { echo 'bob failed'; failed=1; }
  return $failed
}
# weekly log
wl() {
  local failed=0
  pxl  || { echo 'pxl failed'; failed=1; }
  ngl  || { echo 'ngl failed'; failed=1; }
  rl   || { echo 'rl failed'; failed=1; }
  bobl || { echo 'bobl failed'; failed=1; }
  return $failed
}
# yadm-public track all
wuta() {
  local -a files=(
    "$HOME/.config/nvim/lazy-lock.json"
    "$HOME/pipx-packages.txt"
    "$HOME/global-npm-packages.txt"
    "$HOME/rust-toolchains.txt"
    "$HOME/cargo-packages.txt"
    "$HOME/bob-versions.txt"
  )
  yadm-public add -- "${files[@]}" || return 1
  if yadm-public diff --cached --quiet -- "${files[@]}"; then
    echo 'No dependency changes to commit.'
    return 0
  fi
  yadm-public commit --only -m 'chore(env): update deps' -- "${files[@]}" && yadm-public push
}
# weekly update, log, yadm track all, and claude history sync
wua() {
  local failed=0
  wup  || failed=1
  wl   || failed=1
  wuta || failed=1
  chap || failed=1
  return $failed
}
