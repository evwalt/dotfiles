[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[user]
	; name = evan-walter
	name = evwalt
	email = 57516308+evwalt@users.noreply.github.com
[color]
	ui = true
[init]
	defaultBranch = main

# --- git-delta ---
[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
	# dark = true      # or light = true, or omit for auto-detection
	# side-by-side = true
	tab-width = 4
	# Harbor Night: diff backgrounds match the Claude Code theme (~/.claude/themes/harbor-night.json)
	syntax-theme = Coldark-Dark
	minus-style = syntax "#2a1720"
	minus-emph-style = syntax "#6b3247"
	plus-style = syntax "#16261f"
	plus-emph-style = syntax "#2c5540"
	# Brighter than delta's defaults so numbers and gutters stay readable
	line-numbers-zero-style = "#8a8fb0"
	line-numbers-minus-style = "#e08592"
	line-numbers-plus-style = "#88c9a4"
	line-numbers-left-style = "#4a4c70"
	line-numbers-right-style = "#4a4c70"
	file-style = "#b1b9f9" bold
	file-decoration-style = "#4a4c70" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#4a4c70" box

[merge]
    conflictstyle = zdiff3
